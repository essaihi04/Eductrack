{
  "appId": "org.edtrack.app",
  "appName": "Bousole",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://etrack.ma",
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "etrack.ma",
      "*.etrack.ma"
    ]
  },
  "ios": {
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#1e3a5f"
    }
  }
}
