PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API (pour le module IA)
OPENAI_API_KEY=your_openai_api_key

# DeepSeek API (pour les rapports IA et chatbot)
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek-OCR API (import des relevés bancaires PDF -> lignes)
# Optionnel : si absent, DEEPSEEK_API_KEY est utilisée pour l'OCR.
DEEPSEEK_OCR_API_KEY=your_deepseek_ocr_api_key

# Mistral OCR (import d'emplois du temps : photos, captures, PDF scannés)
# La structuration du texte est faite par DeepSeek (DEEPSEEK_API_KEY ci-dessus).
# Mistral n'intervient que sur les pages SANS couche texte : un PDF exporté
# depuis Excel/Word ne consomme donc aucun crédit OCR.
MISTRAL_API_KEY=your_mistral_api_key

MISTRAL_OCR_MODEL=mistral-ocr-latest

# WhatsApp Cloud API (officielle Meta) — SEUL provider WhatsApp du projet.
# Token central pour toutes les écoles ; chaque école a son phone_number_id
# dans whatsapp_school_sessions (renseigné par l'onboarding de l'onglet Connexion).
# WA_OUTBOUND=off coupe toutes les notifications sortantes (le chatbot reste actif).
WA_TOKEN=your_meta_system_user_permanent_token
WA_WABA_ID=your_whatsapp_business_account_id
WA_API_VERSION=v21.0
WA_VERIFY_TOKEN=invente_une_chaine_secrete_pour_le_webhook
WA_APP_SECRET=your_meta_app_secret

# Porte d'entrée transport (active le message à boutons au départ du bus).
# À mettre à true UNIQUEMENT quand le template Cloud à boutons est approuvé.
TRANSPORT_GATE_ENABLED=false
WA_TRANSPORT_TEMPLATE=transport_depart   # nom du template approuvé par Meta

# Webhook Configuration
WEBHOOK_BASE_URL=https://etrack.ma

# ---------------------------------------------------------------------------
# Vérification LOCALE du JWT (performance)
# ---------------------------------------------------------------------------
# Sans ce secret, chaque requête API appelle le service Auth par le réseau pour
# valider le jeton. Avec, la signature est vérifiée sur place : c'est le poste
# le plus lourd de l'API qui disparaît (voir src/utils/authToken.js).
#
# Où le trouver :
#   Supabase Cloud       → Dashboard → Settings → API → JWT Settings → JWT Secret
#   Supabase auto-hébergé→ la variable JWT_SECRET du docker-compose (la même qui
#                          a servi à générer les clés anon / service_role)
#
# À la migration Cloud → auto-hébergé, seule la VALEUR change : le mécanisme est
# identique (GoTrue signe en HS256 des deux côtés).
SUPABASE_JWT_SECRET=

# Optionnel. Vérifie aussi l'émetteur du jeton. À laisser VIDE tant que la
# migration n'est pas faite : l'émetteur passe de
# https://xxx.supabase.co/auth/v1 à https://votre-domaine/auth/v1, et une valeur
# figée pendant la bascule bloquerait toutes les connexions.
SUPABASE_JWT_ISSUER=

# Durée de vie du cache profil (rôle, école) en millisecondes. 0 = désactivé.
# Contrepartie : un changement de rôle met jusqu'à cette durée à s'appliquer
# aux sessions déjà ouvertes.
PROFILE_CACHE_TTL_MS=30000
