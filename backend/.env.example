PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API (pour le module IA)
OPENAI_API_KEY=your_openai_api_key

# DeepSeek API (pour les rapports IA et chatbot)
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek-OCR API (import des relevés bancaires PDF -> lignes)
# Optionnel : si absent, DEEPSEEK_API_KEY est utilisée pour l'OCR.
DEEPSEEK_OCR_API_KEY=your_deepseek_ocr_api_key

# WasenderAPI (WhatsApp Business API)
WASENDER_API_KEY=your_wasender_global_api_key
WASENDER_WEBHOOK_SECRET=your_webhook_secret_optional

# WhatsApp Cloud API (officielle Meta) — token central pour toutes les écoles.
# Une école bascule en Cloud via whatsapp_school_sessions.provider='cloud' + phone_number_id.
WA_TOKEN=your_meta_system_user_permanent_token
WA_WABA_ID=your_whatsapp_business_account_id
WA_API_VERSION=v21.0
WA_VERIFY_TOKEN=invente_une_chaine_secrete_pour_le_webhook
WA_APP_SECRET=your_meta_app_secret

# Porte d'entrée transport (active le message à boutons au départ du bus).
# À mettre à true UNIQUEMENT quand le template Cloud à boutons est approuvé.
TRANSPORT_GATE_ENABLED=false
WA_TRANSPORT_TEMPLATE=transport_depart   # nom du template approuvé par Meta

# Webhook Configuration
WEBHOOK_BASE_URL=https://etrack.ma
